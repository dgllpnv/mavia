{
  "name": "mavia",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:domain": "pnpm --filter @mavia/domain test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "db:migrate": "pnpm --filter @mavia/api db:migrate",
    "db:seed": "pnpm --filter @mavia/api db:seed",
    "e2e": "pnpm --filter @mavia/web e2e",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.23.13",
    "turbo": "^2",
    "typescript": "^5.7",
    "typescript-eslint": "^8.69.0"
  }
}
